# ==========================================================================
# Wicoach — environment variables
# Copy this file to `.env.local` and fill in the values.
# Never commit `.env.local`. All keys below have FREE tiers (0€/month).
# ==========================================================================

# --- Supabase (https://supabase.com -> Project Settings) -----------------
# Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Settings > API -> service_role (server only, NEVER exposed to the client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Settings > Database -> Connection string -> "Transaction" pooler (port 6543).
# Used by Drizzle. Add `?sslmode=require` if your client needs it.
# Example: postgresql://postgres.<ref>:<password>@aws-0-eu-west-3.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.YOUR-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Storage bucket name for meal photos (create it in Supabase > Storage).
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=meal-photos

# --- LLM providers -------------------------------------------------------
# The app routes tasks: reasoning/coach/onboarding -> Groq (free, fast, big
# quota), photo analysis -> Gemini (best free vision). Automatic fallback
# between any configured providers on quota errors. Set at least one.

# Google Gemini — https://aistudio.google.com/apikey (free, no CB, vision).
GEMINI_API_KEY=your-google-ai-studio-key
GEMINI_MODEL=gemini-2.5-flash

# Groq — https://console.groq.com/keys (free, no CB, very fast, tool-calling).
# Recommended primary for the coach/onboarding to spare the Gemini quota.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter — https://openrouter.ai/keys (optional extra fallback, has free models).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_VISION_MODEL=google/gemini-2.0-flash-exp:free

# --- App -----------------------------------------------------------------
# Public base URL of the deployment (used for auth redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: protects the cron routes so only the Vercel Cron can call them.
# If set, the cron must send `Authorization: Bearer <CRON_SECRET>` (Vercel does
# this automatically). Leave empty to keep the routes open.
CRON_SECRET=

# --- Rappels par email (https://resend.com — free tier) ------------------
# "API Keys" dans Resend. Sans domaine vérifié, tu peux envoyer depuis
# onboarding@resend.dev VERS l'email de ton compte Resend uniquement.
RESEND_API_KEY=
# Expéditeur. Laisse vide pour utiliser "Wicoach <onboarding@resend.dev>".
REMINDER_FROM=

# --- Notifications push iPhone (Web Push / VAPID) ------------------------
# Génère une paire avec : npx web-push generate-vapid-keys
# La clé PUBLIQUE doit être exposée au client (préfixe NEXT_PUBLIC_).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact requis par la spec Web Push (un mailto suffit).
VAPID_SUBJECT=mailto:wissemkarboub@gmail.com
